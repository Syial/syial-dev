---
import type { CollectionEntry } from "astro:content";
import ProjectLinks from "./ProjectLinks.astro";

interface Props {
  project: CollectionEntry<"projets">;
}

const { project } = Astro.props;
const { title, description, tags, repoUrl, liveUrl, thumb } = project.data;

const hasDetails = Boolean(project.body?.trim());
---

<li class="project-card">
  <div class:list={["project-card-row", thumb && "has-thumb"]}>
    {thumb && (
      <img
        src={thumb}
        alt=""
        class="project-thumb"
        loading="lazy"
        width="140"
        height="140"
      />
    )}
    <div class="project-card-body">
      {tags.length > 0 && (
        <p class="type-meta text-ink-faint">
          {tags.join(" · ")}
        </p>
      )}
      <h3 class="type-entry">
        {title}
      </h3>
      <p class="type-ui text-ink-soft font-normal">
        {description}
      </p>
      <ProjectLinks
        liveUrl={liveUrl}
        repoUrl={repoUrl}
        detailsHref={hasDetails ? `/projets/${project.id}` : undefined}
        class="flex flex-wrap gap-x-lg gap-y-xs"
      />
    </div>
  </div>
</li>
