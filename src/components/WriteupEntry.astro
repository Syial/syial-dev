---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/format";

interface Props {
  writeup: CollectionEntry<"writeups">;
}

const { writeup } = Astro.props;
const { title, date } = writeup.data;
---

<li class="list-entry">
  <a
    href={`/writeups/${writeup.id}`}
    class="flex items-baseline justify-between gap-lg hover:underline underline-offset-2"
  >
    <span class="type-body text-ink">{title}</span>
    <time
      datetime={date.toISOString()}
      class="type-meta text-ink-faint shrink-0"
    >
      {formatDate(date, "short")}
    </time>
  </a>
</li>
