---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/format";

interface Props {
  writeup: CollectionEntry<"writeups">;
}

const { writeup } = Astro.props;
const { title, date, accroche, tags } = writeup.data;
---

<li class="writeup-card">
  <a href={`/writeups/${writeup.id}`} class="writeup-card-link">
    {tags.length > 0 && (
      <p class="type-meta text-ink-faint">
        {tags.join(" · ")}
      </p>
    )}
    <h3 class="type-entry">
      {title}
    </h3>
    <p class="type-ui text-ink-soft font-normal">
      {accroche}
    </p>
    <time
      datetime={date.toISOString()}
      class="type-meta text-ink-faint writeup-card-date"
    >
      {formatDate(date, "short")}
    </time>
  </a>
</li>
