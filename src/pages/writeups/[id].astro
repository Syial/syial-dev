---
import Layout from "../../layouts/Layout.astro";
import BackLink from "../../components/BackLink.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { formatDate } from "../../lib/format";

export async function getStaticPaths() {
  const writeups = await getCollection("writeups", ({ data }) => !data.draft);
  return writeups.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"writeups">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, accroche, summary, tags, project, externalUrl } = entry.data;
---

<Layout title={`Syial // ${title}`} description={accroche}>
  <BackLink />

  <article>
    <h1 class="page-title type-title">{title}</h1>
    <p class="page-meta type-meta text-ink-faint">
      {formatDate(date, "long")}
      {tags.length > 0 && ` · ${tags.join(" · ")}`}
      {project && (
        <>
          {" · "}
          <a href={`/projets/${project}`} class="hover:underline underline-offset-2">Projet associé</a>
        </>
      )}
      {externalUrl && (
        <>
          {" · "}
          <a
            href={externalUrl}
            class="hover:underline underline-offset-2"
          >
            Lien externe
          </a>
        </>
      )}
    </p>

    <div class="callout">
      <p class="section-label mb-sm">Résumé</p>
      <p class="type-body">{summary}</p>
    </div>

    <div class="prose text-ink-soft">
      <Content />
    </div>
  </article>
</Layout>
